# Absolute path to THIS directory on the host. The session manager starts sessions
# through the Docker socket, and the daemon resolves bind-mount paths on the
# HOST — not inside the session manager container. Without this, mounts silently point
# at a path that only exists inside the session manager and the session gets empty files.
HOST_PROJECT_DIR=/absolute/path/to/periscope

# --- lab topology -----------------------------------------------------------
# sessions at <customer>.psc.test — NOT .localhost: browsers reject a
# cookie scoped to a single-label TLD, which breaks the login entirely.
LAB_DOMAIN=psc.test
TRAEFIK_HTTP_PORT=8088               # host port for the console + sessions

# --- simulated customer -----------------------------------------------------
CUSTOMER_LAN_SUBNET=172.31.90.0/24   # the "customer LAN" the session must reach
CAMERA_IP=172.31.90.10               # fake camera lives here
WG_SERVER_PORT=51820                 # customer's VPN endpoint

# --- session ----------------------------------------------------------------
SESSION_IDLE_MINUTES=30              # reaper kills a session after this

# --- authentik (login + MFA in front of the console) ------------------------
# Generate real values:  openssl rand -base64 48
AK_SECRET_KEY=change-me-openssl-rand-base64-48
AK_DB_PASSWORD=change-me
AK_ADMIN_EMAIL=admin@example.com
AK_ADMIN_PASSWORD=change-me-first-login
AK_BOOTSTRAP_TOKEN=change-me
