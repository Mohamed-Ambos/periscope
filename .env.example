# --- lab topology -----------------------------------------------------------
LAB_DOMAIN=localhost                 # sessions are reachable at <customer>.localhost
TRAEFIK_HTTP_PORT=8088               # host port for the console + sessions

# --- simulated customer -----------------------------------------------------
CUSTOMER_LAN_SUBNET=172.31.90.0/24   # the "customer LAN" the session must reach
CAMERA_IP=172.31.90.10               # fake camera lives here
WG_SERVER_PORT=51820                 # customer's VPN endpoint

# --- session ----------------------------------------------------------------
SESSION_IDLE_MINUTES=30              # reaper kills a session after this

# --- authentik (login + MFA in front of the console) ------------------------
# Generate real values:  openssl rand -base64 48
AK_SECRET_KEY=change-me-openssl-rand-base64-48
AK_DB_PASSWORD=change-me
AK_ADMIN_EMAIL=admin@example.com
AK_ADMIN_PASSWORD=change-me-first-login
AK_BOOTSTRAP_TOKEN=change-me
